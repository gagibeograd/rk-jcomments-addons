<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_rkjccount</name>
	<creationDate>September 2026</creationDate>
	<author>Radnička Klasa</author>
	<authorUrl>https://radnickaklasa.com</authorUrl>
	<copyright>2026 Radnička Klasa</copyright>
	<license>GNU/GPL v2 or later</license>
	<version>1.0.0</version>
	<description>PLG_SYSTEM_RKJCCOUNT_XML_DESCRIPTION</description>

	<files>
		<filename plugin="rkjccount">rkjccount.php</filename>
		<folder>language</folder>
	</files>

	<languages folder="language">
		<language tag="en-GB">en-GB/plg_system_rkjccount.ini</language>
		<language tag="en-GB">en-GB/plg_system_rkjccount.sys.ini</language>
		<language tag="sr-YU">sr-YU/plg_system_rkjccount.ini</language>
		<language tag="sr-YU">sr-YU/plg_system_rkjccount.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="count" type="radio" layout="joomla.form.field.radio.switcher" default="1"
					label="PLG_SYSTEM_RKJCCOUNT_FIELD_COUNT_LABEL" description="PLG_SYSTEM_RKJCCOUNT_FIELD_COUNT_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="placeholder_class" type="text" default="g-article-comments" showon="count:1"
					label="PLG_SYSTEM_RKJCCOUNT_FIELD_CLASS_LABEL" description="PLG_SYSTEM_RKJCCOUNT_FIELD_CLASS_DESC" />
				<field name="icon_html" type="text" default="&lt;i class=&quot;fa fa-comment-o&quot;&gt;&lt;/i&gt;" filter="raw" showon="count:1"
					label="PLG_SYSTEM_RKJCCOUNT_FIELD_ICON_LABEL" description="PLG_SYSTEM_RKJCCOUNT_FIELD_ICON_DESC" />
			</fieldset>
		</fields>
	</config>
</extension>
