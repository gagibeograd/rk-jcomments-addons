<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="jcomments" method="upgrade">
	<name>plg_jcomments_rkvoice</name>
	<creationDate>September 2026</creationDate>
	<author>Radnička Klasa</author>
	<authorUrl>https://radnickaklasa.com</authorUrl>
	<copyright>2026 Radnička Klasa</copyright>
	<license>GNU/GPL v2 or later</license>
	<version>1.0.0</version>
	<description>PLG_JCOMMENTS_RKVOICE_XML_DESCRIPTION</description>
	<files>
		<filename plugin="rkvoice">rkvoice.php</filename>
		<folder>sql</folder>
		<folder>language</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/plg_jcomments_rkvoice.ini</language>
		<language tag="en-GB">en-GB/plg_jcomments_rkvoice.sys.ini</language>
		<language tag="sr-YU">sr-YU/plg_jcomments_rkvoice.ini</language>
		<language tag="sr-YU">sr-YU/plg_jcomments_rkvoice.sys.ini</language>
	</languages>
	<install><sql><file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file></sql></install>
	<update><schemas><schemapath type="mysql">sql/updates/mysql</schemapath></schemas></update>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="max_seconds" type="number" default="60" min="5" max="300" step="5" label="PLG_JCOMMENTS_RKVOICE_FIELD_MAX_SECONDS_LABEL" description="PLG_JCOMMENTS_RKVOICE_FIELD_MAX_SECONDS_DESC" />
				<field name="max_kb" type="number" default="2048" min="256" max="20480" step="256" label="PLG_JCOMMENTS_RKVOICE_FIELD_MAX_KB_LABEL" description="PLG_JCOMMENTS_RKVOICE_FIELD_MAX_KB_DESC" />
				<field name="guests" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_JCOMMENTS_RKVOICE_FIELD_GUESTS_LABEL" description="PLG_JCOMMENTS_RKVOICE_FIELD_GUESTS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="folder" type="text" default="images/jcomment/voice" label="PLG_JCOMMENTS_RKVOICE_FIELD_FOLDER_LABEL" description="PLG_JCOMMENTS_RKVOICE_FIELD_FOLDER_DESC" />
			</fieldset>
		</fields>
	</config>
</extension>
