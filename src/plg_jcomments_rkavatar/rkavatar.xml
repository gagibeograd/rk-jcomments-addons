<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="jcomments" method="upgrade">
	<name>plg_jcomments_rkavatar</name>
	<creationDate>September 2026</creationDate>
	<author>Radnička Klasa</author>
	<authorUrl>https://radnickaklasa.com</authorUrl>
	<copyright>2026 Radnička Klasa</copyright>
	<license>GNU/GPL v2 or later</license>
	<version>1.0.0</version>
	<description>PLG_JCOMMENTS_RKAVATAR_XML_DESCRIPTION</description>

	<files>
		<filename plugin="rkavatar">rkavatar.php</filename>
		<folder>sql</folder>
		<folder>language</folder>
	</files>

	<languages folder="language">
		<language tag="en-GB">en-GB/plg_jcomments_rkavatar.ini</language>
		<language tag="en-GB">en-GB/plg_jcomments_rkavatar.sys.ini</language>
		<language tag="sr-YU">sr-YU/plg_jcomments_rkavatar.ini</language>
		<language tag="sr-YU">sr-YU/plg_jcomments_rkavatar.sys.ini</language>
	</languages>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="gallery_path"
					type="text"
					default="images/jcomment/avatars"
					label="PLG_JCOMMENTS_RKAVATAR_FIELD_GALLERY_PATH_LABEL"
					description="PLG_JCOMMENTS_RKAVATAR_FIELD_GALLERY_PATH_DESC"
				/>
				<field
					name="show_picker"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="PLG_JCOMMENTS_RKAVATAR_FIELD_SHOW_PICKER_LABEL"
					description="PLG_JCOMMENTS_RKAVATAR_FIELD_SHOW_PICKER_DESC"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="remember"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="PLG_JCOMMENTS_RKAVATAR_FIELD_REMEMBER_LABEL"
					description="PLG_JCOMMENTS_RKAVATAR_FIELD_REMEMBER_DESC"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
