<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="jcomments" method="upgrade">
	<name>plg_jcomments_rkpick</name>
	<creationDate>September 2026</creationDate>
	<author>Radnička Klasa</author>
	<authorUrl>https://radnickaklasa.com</authorUrl>
	<copyright>2026 Radnička Klasa</copyright>
	<license>GNU/GPL v2 or later</license>
	<version>1.0.0</version>
	<description>PLG_JCOMMENTS_RKPICK_XML_DESCRIPTION</description>
	<files>
		<filename plugin="rkpick">rkpick.php</filename>
		<folder>sql</folder>
		<folder>language</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/plg_jcomments_rkpick.ini</language>
		<language tag="en-GB">en-GB/plg_jcomments_rkpick.sys.ini</language>
		<language tag="sr-YU">sr-YU/plg_jcomments_rkpick.ini</language>
		<language tag="sr-YU">sr-YU/plg_jcomments_rkpick.sys.ini</language>
	</languages>
	<install><sql><file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file></sql></install>
	<update><schemas><schemapath type="mysql">sql/updates/mysql</schemapath></schemas></update>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="move_top" type="radio" layout="joomla.form.field.radio.switcher" default="1"
					label="PLG_JCOMMENTS_RKPICK_FIELD_MOVE_TOP_LABEL" description="PLG_JCOMMENTS_RKPICK_FIELD_MOVE_TOP_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
